{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["cloudflare/**/*.ts", "domain/**/*.ts", "../../src/shared/distribution/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
