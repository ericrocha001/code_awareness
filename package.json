{
  "name": "code-awareness",
  "version": "1.0.0",
  "description": "Desktop app to analyze code repos and export to Obsidian via Codefetch",
  "author": "Eric Rocha",
  "homepage": "https://github.com/ericrocha001/code_awareness",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win",
    "test": "vitest",
    "test:run": "vitest run",
    "test:domain": "npx vitest run",
    "postinstall": "cd node_modules/better-sqlite3 && npx prebuild-install --runtime=electron --target=30.0.0",
    "native:electron": "cd node_modules/better-sqlite3 && npx prebuild-install --runtime=electron --target=30.0.0",
    "native:node": "cd node_modules/better-sqlite3 && npx prebuild-install",
    "test:db": "electron scripts/run-adapter-tests-electron.js && electron scripts/run-codemap-tests-electron.js",
    "test:db:codemap": "electron scripts/run-codemap-tests-electron.js",
    "test:git": "npx vitest run src/main/core/git-service.test.ts src/main/core/diff-service.test.ts",
    "test:compression": "npx vitest run src/main/core/compression-service.test.ts",
    "test:ui": "npx vitest run src/renderer/src/components/CodeJourneyView/restore-modal.test.tsx"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.2",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.0",
    "@testing-library/react": "^16.1.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.ericrocha.codeawareness",
    "productName": "Code Awareness",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Code Awareness"
    }
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "@types/dompurify": "^3.0.5",
    "@vscode/codicons": "^0.0.46-24",
    "better-sqlite3": "^12.11.1",
    "cytoscape": "^3.34.0",
    "devicon": "^2.17.0",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.12",
    "gitdiff-parser": "^0.3.1",
    "ignore": "^7.0.6",
    "lucide-react": "^1.25.0",
    "markdown-to-jsx": "^9.8.2",
    "prism-react-renderer": "^2.4.1",
    "react-window": "^1.8.10",
    "tree-sitter": "^0.21.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "allowScripts": {
    "tree-sitter@0.21.1": true,
    "tree-sitter-typescript@0.23.2": true,
    "tree-sitter-javascript@0.23.1": true,
    "better-sqlite3@12.11.1": true
  }
}
