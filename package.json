{
  "name": "code-awareness",
  "version": "1.0.0",
  "description": "Desktop app to analyze code repos and export to Obsidian via Codefetch",
  "author": "Eric Rocha",
  "homepage": "https://github.com/ericrocha001/code_awareness",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win",
    "test": "vitest",
    "test:run": "vitest run",
    "postinstall": "electron-rebuild"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.ericrocha.codeawareness",
    "productName": "Code Awareness",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Code Awareness"
    }
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "better-sqlite3": "^12.11.1",
    "devicon": "^2.17.0",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.12",
    "gitdiff-parser": "^0.3.1",
    "lucide-react": "^1.25.0",
    "markdown-to-jsx": "^9.8.2"
  }
}
